Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Image", " ", "shape"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"Not", "@", 
      RowBox[{"StringQ", "@", "data"}]}], ",", 
     RowBox[{"shape", "=", 
      RowBox[{"Shape", "[", 
       RowBox[{"a", ",", 
        RowBox[{"data", "[", "\"\<\[Lambda]\>\"", "]"}], ",", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"data", "[", "\"\<\[Eta]\>\"", "]"}], "]"}], ",", "rs", ",", 
        "\[Theta]s", ",", "ro", ",", 
        RowBox[{"data", "[", "\"\<\[Nu]rs\>\"", "]"}], ",", 
        RowBox[{"data", "[", "\"\<\[Nu]\[Theta]s\>\"", "]"}]}], "]"}]}]}], 
    "]"}], "\[IndentingNewLine]", 
   RowBox[{
   "Print", "[", 
    "\"\<\!\(\*OverscriptBox[\(r\), \(\[Wedge]\)]\), \!\(\*OverscriptBox[\(\
\[Theta]\), \(\[Wedge]\)]\), \!\(\*OverscriptBox[\(\[Phi]\), \(\[Wedge]\)]\): \
the unit base vectors of the spherical coordinate system, normalized to \
length 1.\\nHere they are mapped to the \[Lambda]-\[Eta] plane and \[Alpha]-\
\[Beta] plane.\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Stretch rates of principal axes: \>\"", ",", " ", 
     RowBox[{
      RowBox[{"shape", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", "2"}], "]"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Magnification rate of area: \>\"", ",", " ", 
     RowBox[{
      RowBox[{"shape", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "[", 
      RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{
  3.9338231184006643`*^9, {3.933824811884561*^9, 3.933824962422575*^9}, {
