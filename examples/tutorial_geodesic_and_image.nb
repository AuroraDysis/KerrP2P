          RowBox[{"\"\<r3\>\"", "->", "r3"}], ",", 
          RowBox[{"\"\<r4\>\"", "->", "r4"}], ",", 
          RowBox[{"\"\<w0\>\"", "->", 
           RowBox[{"Cos", "[", 
            RowBox[{
             RowBox[{"\[Theta]pm", "[", 
              RowBox[{"a", ",", "\[Lambda]", ",", "\[Eta]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", 
          RowBox[{"\"\<radial_integrals\>\"", "->", 
           RowBox[{"ray", "[", "\"\<radial_integrals\>\"", "]"}]}], ",", 
          RowBox[{"\"\<angular_integrals\>\"", "->", 
