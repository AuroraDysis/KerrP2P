             RowBox[{"-", "3"}], "+", "rc"}], ")"}], " ", "rc"}]}], ")"}]}], 
       RowBox[{"a", "-", 
        RowBox[{"a", " ", "rc"}]}]]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Eta]c", "[", 
      RowBox[{"rc_", ",", "a_"}], "]"}], ":=", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        SuperscriptBox["rc", "3"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
