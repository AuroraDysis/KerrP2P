            RowBox[{"rcd$to$\[Lambda]\[Eta]", "::", "\[Eta]$imag"}], 
            "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"\[Lambda]c", ",", 
          RowBox[{"Re", "[", "qc2", "]"}]}], "}"}]}]}], "]"}]}], 
