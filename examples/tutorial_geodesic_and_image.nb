   3.902578540031319*^9, 3.902578544895392*^9}, {3.902597228610872*^9, 
   3.9025972532894506`*^9}, {3.902604118457543*^9, 3.902604121871507*^9}, {
   3.9026042836389713`*^9, 3.9026042899830933`*^9}, {3.902606064396861*^9, 
   3.902606093532682*^9}, {3.902606139237174*^9, 3.902606166651945*^9}, {
   3.902606255372882*^9, 3.90260631627302*^9}, {3.902667166234259*^9, 
   3.902667198222859*^9}, {3.9026672421886005`*^9, 3.902667299955287*^9}, {
   3.902667343443427*^9, 3.902667424651361*^9}, {3.902669347946653*^9, 
   3.902669350136109*^9}, {3.902669828207537*^9, 3.9026698499779043`*^9}, {
   3.902673058931084*^9, 3.902673064471263*^9}, 3.90267740826719*^9, {
   3.902758899213555*^9, 3.902758934867635*^9}, {3.902759142368699*^9, 
   3.902759209674923*^9}, {3.902760024630303*^9, 3.902760059165537*^9}, 
   3.90276080711626*^9, {3.902760861500387*^9, 3.902760925706016*^9}, {
   3.902761022969604*^9, 3.902761029184083*^9}, {3.902761066700435*^9, 
   3.902761103178729*^9}, {3.902764617504979*^9, 3.902764640968498*^9}, {
   3.902764712706377*^9, 3.902764808120352*^9}, {3.902765056906154*^9, 
   3.902765057121052*^9}, {3.9027914076349792`*^9, 3.902791426923191*^9}, {
   3.902823975492627*^9, 3.9028239777829866`*^9}, {3.902824083529575*^9, 
   3.9028241066797733`*^9}, {3.902824212921871*^9, 3.902824214552518*^9}, {
   3.903064064173081*^9, 3.903064083258955*^9}, {3.903210928279894*^9, 
   3.903210931422418*^9}, {3.933811848427935*^9, 3.93381189855372*^9}, {
   3.9338127280766697`*^9, 3.933812749855186*^9}, {3.933816926323539*^9, 
   3.9338169945338874`*^9}, {3.933817025135503*^9, 3.933817079198142*^9}, {
   3.933817137319288*^9, 3.933817141275878*^9}},
