    RowBox[{
    "critical", " ", "curve", " ", "on", " ", "the", " ", "\[Lambda]"}], "-", 
    
    RowBox[{"\[Eta]", " ", "plane"}]}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Lambda]c", "[", 
      RowBox[{"rc_", ",", "a_"}], "]"}], ":=", 
     RowBox[{"a", "+", 
      FractionBox[
       RowBox[{"rc", " ", 
