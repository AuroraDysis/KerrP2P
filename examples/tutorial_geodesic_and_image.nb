     RowBox[{"\"\<InsetFont\>\"", "->", "12"}], ",", 
     RowBox[{"ImageSize", "->", "250"}], ",", 
     RowBox[{"FrameTicks", "->", "Automatic"}], ",", 
     RowBox[{"\"\<toprint\>\"", "->", "False"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Shape", "[", 
    RowBox[{
    "a_", ",", "\[Lambda]_", ",", "q_", ",", "rs_", ",", "\[Theta]s_", ",", 
     "ro_", ",", "\[Nu]rs_", ",", "\[Nu]\[Theta]s_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "method", ",", "m\[Lambda]q", ",", "vr1", ",", "v\[Theta]1", ",", 
       "v\[Phi]1", ",", "g1", ",", "range1", ",", "m\[Alpha]\[Beta]", ",", 
       "vr2", ",", "v\[Theta]2", ",", "v\[Phi]2", ",", "g2", ",", "range2", 
       ",", "pts", ",", "sphericalpts", ",", "imagepts", ",", "g3", ",", 
       "range3", ",", "rate1", ",", "rate2"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"method", "=", 
       RowBox[{"OptionValue", "[", "\"\<Method\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"method", "=!=", "\"\<SA\>\""}], "&&", 
         RowBox[{"method", "=!=", "\"\<Numeric\>\""}]}], ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{"Shape", "::", "method"}], "]"}], ";", 
         RowBox[{"Return", "[", 
          RowBox[{"FindImage", "::", "opt"}], "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"m\[Lambda]q", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"method", "==", "\"\<SA\>\""}], ",", 
         RowBox[{"matrix\[Lambda]q$SA", "[", 
