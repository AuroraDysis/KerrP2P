                SuperscriptBox["q", "2"], "+", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"a", "-", "\[Lambda]"}], ")"}], "2"]}], ")"}]}], 
             ")"}]}], "+", 
           SuperscriptBox[
            RowBox[{"(", 
