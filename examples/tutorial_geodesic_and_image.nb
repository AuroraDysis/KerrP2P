   3.9025246034897823`*^9}, {3.902525573554762*^9, 3.902525619489101*^9}, {
   3.902525776400228*^9, 3.902525790306254*^9}, {3.902526025808119*^9, 
   3.9025260307159233`*^9}, {3.902526467733469*^9, 3.9025264681642313`*^9}, {
   3.902560840932794*^9, 3.902560843900503*^9}, {3.902569439268047*^9, 
   3.9025694986670017`*^9}, {3.902569616746772*^9, 3.9025696275065336`*^9}, {
   3.902572393314496*^9, 3.902572400428675*^9}, 3.902572485634303*^9, {
