Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Image", " ", "plane"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
   "Print", "[", 
    "\"\<The image plane:\\nblack\[LongDash]\[LongDash]BH; orange\[LongDash]\
\[LongDash]critical curve; blue\[LongDash]\[LongDash]image\>\"", " ", "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cc$up", "=", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Alpha]c", "[", 
          RowBox[{"rc", ",", "a", ",", "\[Theta]o"}], "]"}], ",", 
         RowBox[{"\[Beta]c", "[", 
          RowBox[{"rc", ",", "a", ",", "\[Theta]o"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"rc", ",", 
         RowBox[{
          RowBox[{"rcRange", "[", "a", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"rcRange", "[", "a", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"FrameStyle", "\[Rule]", "14"}], ",", "\[IndentingNewLine]", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"StringJoin", "[", 
           RowBox[{"\"\<\[Alpha] [\>\"", ",", 
            RowBox[{"ToString", "@", 
             RowBox[{"TraditionalForm", "[", "M", "]"}]}], ",", "\"\<]\>\""}],
            "]"}], ",", 
          RowBox[{"StringJoin", "[", 
           RowBox[{"\"\<\[Beta] [\>\"", ",", 
            RowBox[{"ToString", "@", 
             RowBox[{"TraditionalForm", "[", "M", "]"}]}], ",", "\"\<]\>\""}],
            "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"LabelStyle", "\[Rule]", "14"}], ",", 
       RowBox[{"Axes", "\[Rule]", "False"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Dashed", ",", "Orange", ",", 
          RowBox[{"Thickness", "[", "0.005", "]"}]}], "]"}]}], ",", 
       RowBox[{"PlotPoints", "\[Rule]", "100"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cc$down", "=", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Alpha]c", "[", 
          RowBox[{"rc", ",", "a", ",", "\[Theta]o"}], "]"}], ",", 
         RowBox[{"-", 
          RowBox[{"\[Beta]c", "[", 
           RowBox[{"rc", ",", "a", ",", "\[Theta]o"}], "]"}]}]}], "}"}], ",", 
       
       RowBox[{"{", 
        RowBox[{"rc", ",", 
         RowBox[{
          RowBox[{"rcRange", "[", "a", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"rcRange", "[", "a", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Dashed", ",", "Orange", ",", 
          RowBox[{"Thickness", "[", "0.005", "]"}]}], "]"}]}], ",", 
       RowBox[{"PlotPoints", "\[Rule]", "100"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotimage", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"data", "[", "\"\<\[Alpha]\>\"", "]"}], ",", 
          RowBox[{"data", "[", "\"\<\[Beta]\>\"", "]"}]}], "}"}], "}"}], ",", 
       
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"Directive", "[", 
         RowBox[{"PointSize", "[", "0.03", "]"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotBH", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], "}"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", 
          RowBox[{"PointSize", "[", "0.03", "]"}]}], "]"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{"cc$up", ",", "cc$down", ",", "plotimage", ",", "plotBH", ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "10"}], ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "9"}], ",", "9"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"ImageSize", "->", "200"}]}], "]"}]}]}]], "Input",
