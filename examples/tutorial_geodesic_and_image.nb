Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"transform", " ", 
    RowBox[{"(", 
     RowBox[{"rc", ",", "d"}], ")"}], " ", "to", 
    RowBox[{"(", 
     RowBox[{"\[Lambda]", ",", "\[Eta]"}], ")"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"rcd$to$\[Lambda]\[Eta]", "::", "\[Eta]$imag"}], "=", 
     "\"\<\[Eta] should be real\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"rcd$to$\[Lambda]\[Eta]", "[", 
      RowBox[{"a_", ",", "rc_", ",", "d_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Lambda]c", ",", "qc", ",", "qc2"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Lambda]c", ",", "qc"}], "}"}], "=", 
         RowBox[{"rcd$to$\[Lambda]q", "[", 
          RowBox[{"a", ",", "rc", ",", "d"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"qc2", "=", 
         SuperscriptBox["qc", "2"]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"Im", "[", "qc2", "]"}], "]"}], ">", 
           SuperscriptBox["10", 
