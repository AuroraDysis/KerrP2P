Cell[CellGroupData[{

Cell["Def: FindImage", "Section",
 InitializationCell->True,
 CellChangeTimes->{
  3.902492688265809*^9, {3.934084320631613*^9, 
   3.934084339750648*^9}},ExpressionUUID->"2e08f3b1-728a-4dba-ae83-\
0dc4dd864ddb"],

Cell[TextData[{
 "In this section we define the FindImage function, which solves the imaging \
conditions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[Theta]", "f"], "=", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Theta]", "o"], " ", "and", " ", 
       SubscriptBox["\[Phi]", "f"]}], "\[Congruent]", 
      RowBox[{
       SubscriptBox["\[Phi]", "o"], " ", 
       RowBox[{"(", 
        RowBox[{"mod", " ", "2", "\[Pi]"}], ")"}]}]}]}], ")"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "aeeb375a-1be4-44a1-b420-ec130ba162be"],
 " to give the conserved quantities of a geodesic that reaches the observer, \
and then calculates multiple quantities that describe the trajectory of the \
geodesic, including the half-orbit number ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4ce77fdf-f4ea-4595-a5c0-8154b46d3960"],
 ", polar turning number ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a5c04adf-d05c-427e-8dce-5294374d5e78"],
 ", azimuthal winding angle ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Phi]", "f"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4253cb23-2f0f-47a9-9a48-2d603463b8a4"],
 ", travel time ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "f"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "87ad1998-40a4-4ca7-92d6-2296a655600e"],
 ", apparent position (\[Alpha], \[Beta]) of the resulting image and so on.\n\
\nThis function provides two kinds of input guess values:\n1. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"rc", ",", 
     RowBox[{
      SubscriptBox["log", "10"], "|", "d", "|"}]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b6679203-066f-4164-bf2d-9b4eac7cf875"],
 " together with an string opt=\[OpenCurlyDoubleQuote]in\
\[CloseCurlyDoubleQuote] or \
\[OpenCurlyDoubleQuote]out\[CloseCurlyDoubleQuote] specifying the sign of ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eddd56c5-bb7f-4724-b508-c61a57de714a"],
 " (\[OpenCurlyDoubleQuote]in\[CloseCurlyDoubleQuote] for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "<", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2718da06-fb5e-46ed-a3fb-88a7a0572fd2"],
 " and \[OpenCurlyDoubleQuote]out\[CloseCurlyDoubleQuote] for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", ">", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "01819dd2-b571-40b0-9442-2ec81e70d5f6"],
 ")\n2. (\[Lambda], q)\n\nDue to the fact that higher-order images \
exponentially approach the critical curve, it would require more precise \
guess values of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[Lambda]", ",", "q"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "11b22531-4d14-4b1f-8a15-941c94f98e37"],
 " for larger image levels, and therefore in that case the (rc, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["log", "10"], "|", "d", "|"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8d95559e-bb3d-4855-a8a7-624b552ea7e3"],
 ") input is preferred."
}], "Text",
 CellChangeTimes->{{3.953556030582905*^9, 3.953556047551229*^9}, {
  3.953556159612941*^9, 3.9535561967270823`*^9}, {3.9535563999903307`*^9, 
  3.953556403477221*^9}, {3.953556446346075*^9, 3.9535565183213387`*^9}, {
  3.953556572740219*^9, 3.9535567129976263`*^9}, {3.9535567991980753`*^9, 
  3.953556915278751*^9}, {3.9535569601160707`*^9, 3.953556973218923*^9}, {
  3.953557012943754*^9, 3.953557019658318*^9}, {3.953557059002892*^9, 
  3.953557061037971*^9}, {3.953557954120605*^9, 3.953558063921516*^9}, {
  3.953559638254265*^9, 3.953559782531684*^9}, {3.953559909156638*^9, 
  3.9535601695351562`*^9}, {3.953560200388236*^9, 3.95356022861959*^9}, {
  3.953560928864623*^9, 
  3.9535609300023127`*^9}},ExpressionUUID->"1e05353e-0447-46f3-bf82-\
8fa24b805bf5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"find", " ", "image", " ", "by", " ", "inputting", " ", 
    RowBox[{"(", 
     RowBox[{"rc", ",", " ", "d"}], ")"}], " ", "as", " ", "initial", " ", 
    "guess"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"FindImage", "::", "opt"}], "=", 
     "\"\<opt should be in or out\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FindImage", "::", "\[Nu]rs"}], "=", 
     "\"\<\[Nu]rs should be -1 or +1\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FindImage", "::", "\[Nu]\[Theta]s"}], "=", 
     "\"\<\[Nu]\[Theta]s should be -1 or +1\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "FindImage", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{"\"\<WorkingPrecision\>\"", "->", "30"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FindImage", "[", 
      RowBox[{
      "a0_", ",", "rs0_", ",", "\[Theta]s0_", ",", "ro0_", ",", 
       "\[Nu]rs_Integer", ",", "\[Nu]\[Theta]s_Integer", ",", "\[Theta]o0_", 
       ",", "\[Phi]o0_", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rc1_", "?", "NumericQ"}], ",", 
         RowBox[{"lgAbsd1_", "?", "NumericQ"}]}], "}"}], ",", "opt_String", 
       ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "sol", ",", "rcsol", ",", "dsol", ",", "m", ",", "nhalf", ",", 
         "\[Lambda]", ",", "\[Eta]", ",", "r1", ",", "r2", ",", "r3", ",", 
         "r4", ",", "w0", ",", "root$f", ",", "opt$sign", ",", "\[Alpha]", 
         ",", "\[Beta]", ",", "err", ",", "ray", ",", "a", ",", "rs", ",", 
         "\[Theta]s", ",", "ro", ",", "rc0", ",", "lgAbsd", ",", "\[Theta]o", 
         ",", "\[Phi]o", ",", "\[Theta]f", ",", "\[Phi]f"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"opt", "=!=", "\"\<in\>\""}], "&&", 
           RowBox[{"opt", "=!=", "\"\<out\>\""}]}], ",", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{"FindImage", "::", "opt"}], "]"}], ";", 
           RowBox[{"Return", "[", 
            RowBox[{"FindImage", "::", "opt"}], "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Nu]rs", "=!=", 
            RowBox[{"+", "1"}]}], "&&", 
           RowBox[{"\[Nu]rs", "=!=", 
            RowBox[{"-", "1"}]}]}], ",", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{"FindImage", "::", "\[Nu]rs"}], "]"}], ";", 
           RowBox[{"Return", "[", 
            RowBox[{"FindImage", "::", "\[Nu]rs"}], "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Nu]\[Theta]s", "=!=", 
            RowBox[{"+", "1"}]}], "&&", 
           RowBox[{"\[Nu]\[Theta]s", "=!=", 
            RowBox[{"-", "1"}]}]}], ",", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{"FindImage", "::", "\[Nu]\[Theta]s"}], "]"}], ";", 
           RowBox[{"Return", "[", 
            RowBox[{"FindImage", "::", "\[Nu]\[Theta]s"}], "]"}]}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"opt$sign", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"opt", "===", "\"\<out\>\""}], ",", "1", ",", 
           RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "a", ",", "rs", ",", "\[Theta]s", ",", "ro", ",", "\[Theta]o", ",", 
           "\[Phi]o", ",", "rc0", ",", "lgAbsd"}], "}"}], "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "a0", ",", "rs0", ",", "\[Theta]s0", ",", "ro0", ",", 
             "\[Theta]o0", ",", "\[Phi]o0", ",", "rc1", ",", "lgAbsd1"}], 
            "}"}], ",", 
           RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"root$f", "[", 
          RowBox[{
           RowBox[{"rc_", "?", "NumericQ"}], ",", 
           RowBox[{"lgd_", "?", "NumericQ"}]}], "]"}], ":=", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"rayf", "=", 
             RowBox[{"Rayrcd", "[", 
              RowBox[{
              "a", ",", "rs", ",", "\[Theta]s", ",", "ro", ",", "\[Nu]rs", 
               ",", "\[Nu]\[Theta]s", ",", "rc", ",", 
               RowBox[{"opt$sign", " ", 
                SuperscriptBox["10", "lgd"]}], ",", 
               RowBox[{"WorkingPrecision", "->", 
                RowBox[{
                 RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}], "+", 
                 "10"}]}], ",", 
               RowBox[{"CalculateFinalTime", "->", "False"}]}], "]"}]}], 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"rayf", "[", "\"\<\[Theta]f\>\"", "]"}], "-", 
              "\[Theta]o"}], ",", 
             RowBox[{"Sin", "[", 
              FractionBox[
               RowBox[{
                RowBox[{"rayf", "[", "\"\<\[Phi]f\>\"", "]"}], "-", 
                "\[Phi]o"}], "2"], "]"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"err", "=", 
         RowBox[{"Catch", "[", 
          RowBox[{
           RowBox[{"sol", "=", 
            RowBox[{"FindRoot", "[", 
             RowBox[{
              RowBox[{"root$f", "[", 
               RowBox[{"rc", ",", "lgd"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"rc", ",", "rc0"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"lgd", ",", "lgAbsd"}], "}"}]}], "}"}], ",", " ", 
              RowBox[{"WorkingPrecision", "->", 
               RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}]}], 
             "]"}]}], ";"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"err", "=!=", "Null"}], ",", 
          RowBox[{"Return", "[", "err", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"rcsol", ",", "dsol"}], "}"}], "=", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rc", ",", 
            RowBox[{"opt$sign", " ", 
             SuperscriptBox["10", "lgd"]}]}], "}"}], "/.", "sol"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ray", "=", 
         RowBox[{"Rayrcd", "[", 
          RowBox[{
          "a", ",", "rs", ",", "\[Theta]s", ",", "ro", ",", "\[Nu]rs", ",", 
           "\[Nu]\[Theta]s", ",", "rcsol", ",", "dsol", ",", 
           RowBox[{"WorkingPrecision", "->", 
            RowBox[{
             RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}], "+", 
             "10"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Theta]f", ",", "\[Phi]f", ",", "m", ",", "nhalf"}], 
          "}"}], "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ray", "[", "\"\<\[Theta]f\>\"", "]"}], ",", 
           RowBox[{"ray", "[", "\"\<\[Phi]f\>\"", "]"}], ",", 
           RowBox[{"ray", "[", "\"\<m\>\"", "]"}], ",", 
           RowBox[{"ray", "[", "\"\<nhalf\>\"", "]"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Lambda]", ",", "\[Eta]"}], "}"}], "=", 
         RowBox[{"rcd$to$\[Lambda]\[Eta]", "[", 
          RowBox[{"a", ",", "rcsol", ",", "dsol"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"w0", "=", 
         RowBox[{"Cos", "[", 
          RowBox[{
           RowBox[{"\[Theta]pm", "[", 
            RowBox[{"a", ",", "\[Lambda]", ",", "\[Eta]"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], "=", 
         RowBox[{"conserve$to$ob", "[", 
          RowBox[{"a", ",", "\[Lambda]", ",", "\[Eta]", ",", "\[Theta]f", ",", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "m"], " ", "\[Nu]\[Theta]s"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r1", ",", "r2", ",", "r3", ",", "r4"}], "}"}], "=", 
         RowBox[{"radial$potential$roots", "[", 
          RowBox[{"a", ",", "\[Lambda]", ",", "\[Eta]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<a\>\"", "->", "a"}], ",", 
          RowBox[{"\"\<\[Lambda]\>\"", "->", "\[Lambda]"}], ",", 
          RowBox[{"\"\<\[Eta]\>\"", "->", "\[Eta]"}], ",", 
          RowBox[{"\"\<rs\>\"", "->", "rs"}], ",", 
          RowBox[{"\"\<\[Theta]s\>\"", "->", "\[Theta]s"}], ",", 
          RowBox[{"\"\<ro\>\"", "->", "ro"}], ",", 
          RowBox[{"\"\<\[Tau]o\>\"", "->", 
           RowBox[{"ray", "[", "\"\<\[Tau]o\>\"", "]"}]}], ",", 
          RowBox[{"\"\<\[Theta]f\>\"", "->", 
           RowBox[{"ray", "[", "\"\<\[Theta]f\>\"", "]"}]}], ",", 
          RowBox[{"\"\<\[Phi]f\>\"", "->", 
           RowBox[{"ray", "[", "\"\<\[Phi]f\>\"", "]"}]}], ",", 
          RowBox[{"\"\<tf\>\"", "->", 
           RowBox[{"ray", "[", "\"\<tf\>\"", "]"}]}], ",", 
          RowBox[{"\"\<\[Theta]o-\[Theta]f\>\"", "->", 
           RowBox[{"\[Theta]o", "-", 
            RowBox[{"ray", "[", "\"\<\[Theta]f\>\"", "]"}]}]}], ",", 
          RowBox[{
          "\"\<Sin[\!\(\*FractionBox[\(\[Phi]f - \[Phi]o\), \(2\)]\)]\>\"", "->", 
           RowBox[{"Sin", "[", 
            FractionBox[
             RowBox[{"\[Phi]f", "-", "\[Phi]o"}], "2"], "]"}]}], ",", 
          RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
