  3.934083891571796*^9, 
  3.934083891901745*^9}},ExpressionUUID->"29b703e6-4a7a-4cee-872e-\
7a41adb5b80e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "NRay", "]"}], "=", 
