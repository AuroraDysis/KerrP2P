          RowBox[{"r4", ">", "rp"}]}]}], ";", 
        RowBox[{"(*", 
         RowBox[{
         "whether", " ", "there", " ", "are", " ", "radial", " ", "turning", 
          " ", "points", " ", "outside", " ", "horizon"}], "*)"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
