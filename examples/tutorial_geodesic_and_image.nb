Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"angular", " ", 
    RowBox[{"antiderivatives", ":", " ", 
     RowBox[{"type", " ", "A", " ", 
      RowBox[{"(", 
       RowBox[{"\[Eta]", ">", "0"}], ")"}]}]}]}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "AngularAnti", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{"CalculateFinalTime", "->", "True"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"AngularAnti", "[", 
      RowBox[{
      "a_", ",", "\[Lambda]_", ",", "\[Eta]_", ",", "\[Theta]s_", ",", 
       "\[Nu]\[Theta]_", ",", "\[Tau]o_", ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[CapitalDelta]\[Theta]", ",", "up", ",", "um", ",", 
         "\[ScriptCapitalG]$\[Theta]\[Phi]t", ",", 
         "\[ScriptCapitalG]$\[Theta]\[Phi]t$\[Theta]p", ",", 
         "\[ScriptCapitalG]$\[Theta]\[Phi]t$\[Theta]m", ",", 
         "\[ScriptCapitalG]\[Theta]$\[Theta]s", ",", 
         "\[ScriptCapitalG]\[Theta]$\[Theta]p", ",", 
         "\[ScriptCapitalG]\[Theta]$\[Theta]m", ",", 
         "\[ScriptCapitalG]$\[Theta]\[Phi]t$\[Theta]s", ",", "\[Theta]f", ",",
          "m", ",", "nhalf"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[CapitalDelta]\[Theta]", "=", 
         RowBox[{
          FractionBox["1", "2"], " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            FractionBox[
             RowBox[{"\[Eta]", "+", 
              SuperscriptBox["\[Lambda]", "2"]}], 
             SuperscriptBox["a", "2"]]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"up", "=", 
         RowBox[{"\[CapitalDelta]\[Theta]", "+", 
          SqrtBox[
           RowBox[{
            SuperscriptBox["\[CapitalDelta]\[Theta]", "2"], "+", 
            FractionBox["\[Eta]", 
             SuperscriptBox["a", "2"]]}]]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"um", "=", 
         RowBox[{"\[CapitalDelta]\[Theta]", "-", 
          SqrtBox[
           RowBox[{
            SuperscriptBox["\[CapitalDelta]\[Theta]", "2"], "+", 
            FractionBox["\[Eta]", 
             SuperscriptBox["a", "2"]]}]]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\[ScriptCapitalG]$\[Theta]\[Phi]t", "[", "\[Theta]_", "]"}],
          ":=", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"OptionValue", "[", "CalculateFinalTime", "]"}], ",", 
             RowBox[{"Append", "[", 
              RowBox[{"#", ",", 
               RowBox[{
                FractionBox["1", 
                 SqrtBox[
                  RowBox[{
                   RowBox[{"-", 
                    SuperscriptBox["a", "2"]}], " ", "um"}]]], 
                RowBox[{"um", " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"EllipticE", "[", 
                    RowBox[{
                    RowBox[{"ArcCsc", "[", 
                    RowBox[{
                    SqrtBox["up"], " ", 
                    RowBox[{"Sec", "[", "\[Theta]", "]"}]}], "]"}], ",", 
                    FractionBox["up", "um"]}], "]"}], "-", 
                   RowBox[{"EllipticF", "[", 
                    RowBox[{
                    RowBox[{"ArcCsc", "[", 
                    RowBox[{
                    SqrtBox["up"], " ", 
                    RowBox[{"Sec", "[", "\[Theta]", "]"}]}], "]"}], ",", 
                    FractionBox["up", "um"]}], "]"}]}], ")"}]}]}]}], "]"}], 
             ",", "#"}], "]"}], "&"}], "@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", 
             FractionBox[
              RowBox[{"EllipticF", "[", 
               RowBox[{
                RowBox[{"ArcCsc", "[", 
                 RowBox[{
                  SqrtBox["up"], " ", 
                  RowBox[{"Sec", "[", "\[Theta]", "]"}]}], "]"}], ",", 
                FractionBox["up", "um"]}], "]"}], 
              SqrtBox[
               RowBox[{
                RowBox[{"-", 
                 SuperscriptBox["a", "2"]}], " ", "um"}]]]}], ",", 
            RowBox[{"-", 
             FractionBox[
              RowBox[{"EllipticPi", "[", 
               RowBox[{"up", ",", 
                RowBox[{"ArcCsc", "[", 
                 RowBox[{
                  SqrtBox["up"], " ", 
                  RowBox[{"Sec", "[", "\[Theta]", "]"}]}], "]"}], ",", 
                FractionBox["up", "um"]}], "]"}], 
              SqrtBox[
               RowBox[{
                RowBox[{"-", 
                 SuperscriptBox["a", "2"]}], " ", "um"}]]]}]}], "}"}]}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"\[ScriptCapitalG]$\[Theta]\[Phi]t$\[Theta]p", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
