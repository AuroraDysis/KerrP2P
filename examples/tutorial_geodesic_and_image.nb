Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"find", " ", "image", " ", "by", " ", "inputting", " ", 
    RowBox[{"(", 
     RowBox[{"\[Lambda]", ",", "q"}], ")"}], " ", "as", " ", "initial", " ", 
    "guess"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"FindImage\[Lambda]q", "::", "\[Nu]rs"}], "=", 
     "\"\<\[Nu]rs should be -1 or +1\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FindImage\[Lambda]q", "::", "\[Nu]\[Theta]s"}], "=", 
     "\"\<\[Nu]\[Theta]s should be -1 or +1\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "FindImage\[Lambda]q", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{"WorkingPrecision", "->", "30"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FindImage\[Lambda]q", "[", 
      RowBox[{
      "a0_", ",", "rs0_", ",", "\[Theta]s0_", ",", "ro0_", ",", 
       "\[Nu]rs_Integer", ",", "\[Nu]\[Theta]s_Integer", ",", "\[Theta]o0_", 
       ",", "\[Phi]o0_", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Lambda]1_", "?", "NumericQ"}], ",", 
         RowBox[{"q1_", "?", "NumericQ"}]}], "}"}], ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "sol", ",", "\[Lambda]sol", ",", "qsol", ",", "m", ",", "nhalf", ",", 
         "rc", ",", "d", ",", "r1", ",", "r2", ",", "r3", ",", "r4", ",", 
         "w0", ",", "root$f", ",", "\[Alpha]", ",", "\[Beta]", ",", "err", 
         ",", "ray", ",", "a", ",", "rs", ",", "\[Theta]s", ",", "ro", ",", 
         "\[Lambda]0", ",", "q0", ",", "\[Theta]o", ",", "\[Phi]o", ",", 
         "\[Theta]f", ",", "\[Phi]f"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Nu]rs", "=!=", 
            RowBox[{"+", "1"}]}], "&&", 
           RowBox[{"\[Nu]rs", "=!=", 
            RowBox[{"-", "1"}]}]}], ",", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{"FindImage", "::", "\[Nu]rs"}], "]"}], ";", 
           RowBox[{"Return", "[", 
            RowBox[{"FindImage", "::", "\[Nu]rs"}], "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Nu]\[Theta]s", "=!=", 
            RowBox[{"+", "1"}]}], "&&", 
           RowBox[{"\[Nu]\[Theta]s", "=!=", 
            RowBox[{"-", "1"}]}]}], ",", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{"FindImage", "::", "\[Nu]\[Theta]s"}], "]"}], ";", 
           RowBox[{"Return", "[", 
            RowBox[{"FindImage", "::", "\[Nu]\[Theta]s"}], "]"}]}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "a", ",", "rs", ",", "\[Theta]s", ",", "ro", ",", "\[Theta]o", ",", 
           "\[Phi]o", ",", "\[Lambda]0", ",", "q0"}], "}"}], "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "a0", ",", "rs0", ",", "\[Theta]s0", ",", "ro0", ",", 
             "\[Theta]o0", ",", "\[Phi]o0", ",", "\[Lambda]1", ",", "q1"}], 
            "}"}], ",", 
           RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"root$f", "[", 
          RowBox[{
           RowBox[{"\[Lambda]_", "?", "NumericQ"}], ",", 
           RowBox[{"q_", "?", "NumericQ"}]}], "]"}], ":=", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"rayf", "=", 
             RowBox[{"Ray\[Lambda]\[Eta]", "[", 
              RowBox[{
              "a", ",", "rs", ",", "\[Theta]s", ",", "ro", ",", "\[Nu]rs", 
               ",", "\[Nu]\[Theta]s", ",", "\[Lambda]", ",", 
               SuperscriptBox["q", "2"], ",", 
               RowBox[{"WorkingPrecision", "->", 
                RowBox[{
                 RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}], "+", 
                 "10"}]}], ",", 
               RowBox[{"CalculateFinalTime", "->", "False"}]}], "]"}]}], 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"rayf", "[", "\"\<\[Theta]f\>\"", "]"}], "-", 
              "\[Theta]o"}], ",", 
             RowBox[{"Sin", "[", 
              FractionBox[
               RowBox[{
                RowBox[{"rayf", "[", "\"\<\[Phi]f\>\"", "]"}], "-", 
                "\[Phi]o"}], "2"], "]"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"err", "=", 
         RowBox[{"Catch", "[", 
          RowBox[{
           RowBox[{"sol", "=", 
            RowBox[{"FindRoot", "[", 
             RowBox[{
              RowBox[{"root$f", "[", 
               RowBox[{"\[Lambda]", ",", "q"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"\[Lambda]", ",", "\[Lambda]0"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"q", ",", "q0"}], "}"}]}], "}"}], ",", " ", 
              RowBox[{"WorkingPrecision", "->", 
               RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}]}], 
             "]"}]}], ";"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"err", "=!=", "Null"}], ",", 
          RowBox[{"Return", "[", "err", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Lambda]sol", ",", "qsol"}], "}"}], "=", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Lambda]", ",", "q"}], "}"}], "/.", "sol"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ray", "=", 
         RowBox[{"(*", "Rayrcd", "*)"}], 
         RowBox[{"Ray\[Lambda]\[Eta]", "[", 
          RowBox[{
          "a", ",", "rs", ",", "\[Theta]s", ",", "ro", ",", "\[Nu]rs", ",", 
           "\[Nu]\[Theta]s", ",", "\[Lambda]sol", ",", 
           SuperscriptBox["qsol", "2"], ",", 
           RowBox[{"WorkingPrecision", "->", 
            RowBox[{
             RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}], "+", 
             "10"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Theta]f", ",", "\[Phi]f", ",", "m", ",", "nhalf"}], 
          "}"}], "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ray", "[", "\"\<\[Theta]f\>\"", "]"}], ",", 
           RowBox[{"ray", "[", "\"\<\[Phi]f\>\"", "]"}], ",", 
           RowBox[{"ray", "[", "\"\<m\>\"", "]"}], ",", 
           RowBox[{"ray", "[", "\"\<nhalf\>\"", "]"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"rc", ",", "d"}], "}"}], "=", 
         RowBox[{"\[Lambda]q$to$rcd", "[", 
          RowBox[{"a", ",", "\[Lambda]sol", ",", "qsol"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"w0", "=", 
         RowBox[{"Cos", "[", 
          RowBox[{
           RowBox[{"\[Theta]pm", "[", 
            RowBox[{"a", ",", "\[Lambda]sol", ",", 
             SuperscriptBox["qsol", "2"]}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], "=", 
         RowBox[{"conserve$to$ob", "[", 
          RowBox[{"a", ",", "\[Lambda]sol", ",", 
           SuperscriptBox["qsol", "2"], ",", "\[Theta]f", ",", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "m"], " ", "\[Nu]\[Theta]s"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r1", ",", "r2", ",", "r3", ",", "r4"}], "}"}], "=", 
         RowBox[{"radial$potential$roots", "[", 
          RowBox[{"a", ",", "\[Lambda]sol", ",", 
           SuperscriptBox["qsol", "2"]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<a\>\"", "->", "a"}], ",", 
          RowBox[{"\"\<\[Lambda]\>\"", "\[Rule]", "\[Lambda]sol"}], ",", 
          RowBox[{"\"\<\[Eta]\>\"", "->", 
           SuperscriptBox["qsol", "2"]}], ",", 
          RowBox[{"\"\<q\>\"", "->", "qsol"}], ",", 
          RowBox[{"\"\<rs\>\"", "->", "rs"}], ",", 
          RowBox[{"\"\<\[Theta]s\>\"", "->", "\[Theta]s"}], ",", 
          RowBox[{"\"\<ro\>\"", "->", "ro"}], ",", 
          RowBox[{"\"\<\[Tau]o\>\"", "->", 
           RowBox[{"ray", "[", "\"\<\[Tau]o\>\"", "]"}]}], ",", 
          RowBox[{"\"\<\[Theta]f\>\"", "->", 
           RowBox[{"ray", "[", "\"\<\[Theta]f\>\"", "]"}]}], ",", 
          RowBox[{"\"\<\[Phi]f\>\"", "->", 
           RowBox[{"ray", "[", "\"\<\[Phi]f\>\"", "]"}]}], ",", 
          RowBox[{"\"\<tf\>\"", "->", 
           RowBox[{"ray", "[", "\"\<tf\>\"", "]"}]}], ",", 
          RowBox[{"\"\<\[Theta]o-\[Theta]f\>\"", "->", 
           RowBox[{"\[Theta]o", "-", 
            RowBox[{"ray", "[", "\"\<\[Theta]f\>\"", "]"}]}]}], ",", 
          RowBox[{
          "\"\<Sin[\!\(\*FractionBox[\(\[Phi]f - \[Phi]o\), \(2\)]\)]\>\"", "->", 
           RowBox[{"Sin", "[", 
            FractionBox[
             RowBox[{"\[Phi]f", "-", "\[Phi]o"}], "2"], "]"}]}], ",", 
          RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
          RowBox[{"\"\<nhalf\>\"", "->", "nhalf"}], ",", 
          RowBox[{"\"\<Mod[\[Phi]f, 2\[Pi]]\>\"", "->", 
           RowBox[{"Mod", "[", 
            RowBox[{"\[Phi]f", ",", 
             RowBox[{"2", "\[Pi]"}]}], "]"}]}], ",", 
          RowBox[{"\"\<\[Alpha]\>\"", "->", "\[Alpha]"}], ",", 
          RowBox[{"\"\<\[Beta]\>\"", "->", "\[Beta]"}], ",", 
          RowBox[{"\"\<\[Nu]rs\>\"", "->", "\[Nu]rs"}], ",", 
          RowBox[{"\"\<\[Nu]\[Theta]s\>\"", "->", "\[Nu]\[Theta]s"}], ",", 
          RowBox[{"\"\<rc\>\"", "\[Rule]", "rc"}], ",", 
          RowBox[{"\"\<d\>\"", "\[Rule]", "d"}], ",", 
          RowBox[{"\"\<r1\>\"", "->", "r1"}], ",", 
          RowBox[{"\"\<r2\>\"", "->", "r2"}], ",", 
          RowBox[{"\"\<r3\>\"", "->", "r3"}], ",", 
          RowBox[{"\"\<r4\>\"", "->", "r4"}], ",", 
          RowBox[{"\"\<w0\>\"", "->", 
           RowBox[{"Cos", "[", 
            RowBox[{
             RowBox[{"\[Theta]pm", "[", 
              RowBox[{"a", ",", "\[Lambda]sol", ",", 
               SuperscriptBox["qsol", "2"]}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", 
          RowBox[{"\"\<radial_integrals\>\"", "->", 
           RowBox[{"ray", "[", "\"\<radial_integrals\>\"", "]"}]}], ",", 
          RowBox[{"\"\<angular_integrals\>\"", "->", 
           RowBox[{"ray", "[", "\"\<angular_integrals\>\"", "]"}]}]}], 
         "|>"}]}]}], "]"}]}], ";"}]}]}]], "Input",
