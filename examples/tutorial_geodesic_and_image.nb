Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "Rayrcd", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"WorkingPrecision", "->", "30"}], ",", 
     RowBox[{"CalculateFinalTime", "->", "True"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Rayrcd", "[", 
    RowBox[{
    "a0_", ",", "rs0_", ",", "\[Theta]s0_", ",", "rf_", ",", "\[Nu]r_Integer",
      ",", "\[Nu]\[Theta]_Integer", ",", 
     RowBox[{"rc0_", "?", "NumericQ"}], ",", 
     RowBox[{"d0_", "?", "NumericQ"}], ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "rc", ",", "d", ",", "\[Lambda]", ",", "\[Eta]"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "rc", ",", "d"}], "}"}], "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a0", ",", "rc0", ",", "d0"}], "}"}], ",", 
         RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Lambda]", ",", "\[Eta]"}], "}"}], "=", 
       RowBox[{"rcd$to$\[Lambda]\[Eta]", "[", 
        RowBox[{"a", ",", "rc", ",", "d"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Ray\[Lambda]\[Eta]", "[", 
       RowBox[{
       "a0", ",", "rs0", ",", "\[Theta]s0", ",", "rf", ",", "\[Nu]r", ",", 
        "\[Nu]\[Theta]", ",", "\[Lambda]", ",", "\[Eta]", ",", 
        RowBox[{"WorkingPrecision", "->", 
         RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}], ",", 
        RowBox[{"CalculateFinalTime", "->", 
         RowBox[{"OptionValue", "[", "CalculateFinalTime", "]"}]}]}], 
       "]"}]}]}], "]"}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9024948499981403`*^9, 3.9024949476158676`*^9}, {
   3.902494986856045*^9, 3.9024950051933537`*^9}, {3.902495040483651*^9, 
   3.902495060353674*^9}, {3.9024955782045345`*^9, 3.902495593939327*^9}, {
   3.902495736484879*^9, 3.902495741530994*^9}, {3.90249598825095*^9, 
   3.9024960142527113`*^9}, {3.9024963170214825`*^9, 3.902496348108469*^9}, {
   3.902496386288829*^9, 3.902496410584226*^9}, {3.902496457907055*^9, 
   3.90249645808769*^9}, 3.902496901514795*^9, 3.902560804872178*^9, {
   3.902576955123917*^9, 3.9025769606666546`*^9}, {3.902577361767798*^9, 
   3.902577386779948*^9}, {3.902758882040739*^9, 3.902758893990244*^9}, {
   3.902765281498136*^9, 3.902765290676862*^9}},
