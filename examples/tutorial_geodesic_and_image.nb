       RowBox[{
        RowBox[{"r4", "=", 
         RowBox[{
          RowBox[{"radial$potential$roots", "[", 
           RowBox[{"a", ",", "\[Lambda]", ",", "\[Eta]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rp", "=", 
         RowBox[{"1", "+", 
          SqrtBox[
           RowBox[{"1", "-", 
            SuperscriptBox["a", "2"]}]]}]}], ";", "\[IndentingNewLine]", 
