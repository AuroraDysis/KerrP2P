Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Shape", "::", "method"}], "=", 
   "\"\<\\\"Method\\\" should be \\\"SA\\\" or \\\"Numeric\\\"\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "Shape", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<Method\>\"", "->", "\"\<SA\>\""}], ",", 
     RowBox[{"FrameStyle", "->", 
